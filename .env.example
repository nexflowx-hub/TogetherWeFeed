# Together We Feed — environment variables
# Copy to .env.local / configure in Vercel. Never commit live credentials.

# XPayments S2S API
XPAYMENTS_API_BASE_URL=https://api.xpayments.digital/api/v1

# One Store/API key per settlement currency.
# These values are SERVER-ONLY and must never use NEXT_PUBLIC_ prefixes.
XPAYMENTS_API_KEY_EUR=
XPAYMENTS_API_KEY_BRL=

# Add the merchant webhook signing secret(s) only after the current production
# outgoing-webhook signing contract has been certified end-to-end.
XPAYMENTS_WEBHOOK_SECRET_EUR=
XPAYMENTS_WEBHOOK_SECRET_BRL=

# Public application URL
NEXT_PUBLIC_SITE_URL=https://example.org
