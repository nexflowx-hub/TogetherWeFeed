# Together We Feed — environment variables
# Copy to .env.local / configure in Vercel. Never commit live credentials.

# -----------------------------------------------------------------------------
# Campaign checkout controls
# -----------------------------------------------------------------------------
# Leave CHECKOUT_ALLOWED_COUNTRIES empty or use * to keep all supported
# countries available. For a Brazil-only paid-traffic campaign:
# CHECKOUT_ALLOWED_COUNTRIES=BR
CHECKOUT_ALLOWED_COUNTRIES=*

# Per-country enabled payment methods. If a variable is omitted, the app uses
# its built-in country defaults. Example for a PIX-only Brazil campaign:
# CHECKOUT_METHODS_BR=pix
CHECKOUT_METHODS_BR=pix,card,other
CHECKOUT_METHODS_PT=mb_way,multibanco,card,other
CHECKOUT_METHODS_ES=bizum,card,other
CHECKOUT_METHODS_DEFAULT=card,other

# PIX payer identity UX: optional | required | hidden
# `optional` sends the user data only when supplied. If the payment route later
# requires CPF/CNPJ, the checkout asks for it and allows a retry.
CHECKOUT_PIX_PAYER_FIELDS=optional

# Used only as a neutral payer/display name when the donor leaves the PIX name
# empty. No synthetic/generic CPF is inserted in production.
CHECKOUT_PIX_FALLBACK_NAME=Together We Feed - Doador

# Optional message presented when the campaign is closed for a country.
CHECKOUT_COUNTRY_BLOCK_MESSAGE=Os donativos desta campanha não estão disponíveis na sua localização.

# -----------------------------------------------------------------------------
# XPayments Native S2S API
# -----------------------------------------------------------------------------
XPAYMENTS_API_BASE_URL=https://api.xpayments.digital/api/v1

# Native Store/API keys.
# BRL is the PIX/MisticPay Store and must remain isolated from the embedded
# card/wallet Store.
XPAYMENTS_API_KEY_BRL=
XPAYMENTS_API_KEY_EUR=

# -----------------------------------------------------------------------------
# XPayments embedded payment surface
# -----------------------------------------------------------------------------
XPAYMENTS_STRIPE_BASE_URL=https://api.xpayments.digital/api/stripe/v1
XPAYMENTS_STRIPE_API_KEY_EUR=
XPAYMENTS_STRIPE_API_KEY_BRL=

# Browser-safe publishable keys used by the secure embedded payment surface.
XPAYMENTS_STRIPE_PUBLISHABLE_KEY_EUR=
XPAYMENTS_STRIPE_PUBLISHABLE_KEY_BRL=

# Merchant webhooks are optional for payment initiation. Configure later when
# Together We Feed needs authoritative asynchronous donation finality.
XPAYMENTS_WEBHOOK_SECRET_EUR=
XPAYMENTS_WEBHOOK_SECRET_BRL=

# Public application URL
NEXT_PUBLIC_SITE_URL=https://example.org
