# Together We Feed — environment variables
# Copy to .env.local and fill with real values.

# Stripe — REQUIRED for live donations. Without these the checkout
# runs in demo mode (no real charge).
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Public base URL (used for Stripe success/cancel redirects)
NEXT_PUBLIC_SITE_URL=https://hopeheaart.com/pt/
